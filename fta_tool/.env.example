# AI Provider selection
# Options: mock (default), ollama, azure_openai, http_copilot
AI_PROVIDER=mock

# Prompt configuration
# Path to the prompt YAML file (absolute, or relative to fta_tool/)
# Default: config/prompts.yaml
FTA_PROMPT_FILE=config/prompts.yaml
# Debug: set true to log the final generated prompt at INFO level (OllamaProvider only)
# FTA_DEBUG_PROMPT=true

# Factor count per generation call (minimum 1)
FTA_PRIMARY_FACTOR_COUNT=4
FTA_SECONDARY_FACTOR_COUNT=3
FTA_TERTIARY_FACTOR_COUNT=2
FTA_ADDITIONAL_FACTOR_COUNT=2

# Retry settings
# FTA_RETRY_BELOW_MIN=true    retry once when got < desired-1 (default: true)
# FTA_RETRY_BELOW_TARGET=true retry once when got < desired   (default: false)
# Set FTA_RETRY_BELOW_TARGET=true to pursue the target count more aggressively.
# Both settings apply to all levels (primary, secondary, tertiary).
# Set both to false to disable automatic retry entirely.
FTA_RETRY_BELOW_MIN=true
FTA_RETRY_BELOW_TARGET=false

# Ollama settings (used when AI_PROVIDER=ollama)
# Install Ollama from https://ollama.com and run: ollama pull gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# Timeout in seconds. gemma3:4b can take 40-60s on CPU; 360s recommended.
OLLAMA_TIMEOUT_SECONDS=360
# How long Ollama keeps the model loaded in memory after a request.
OLLAMA_KEEP_ALIVE=10m
# Inference options (reduce num_predict and num_ctx for faster generation)
OLLAMA_NUM_PREDICT=768
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=4096

# Azure OpenAI settings (required when AI_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# HTTP Copilot settings (required when AI_PROVIDER=http_copilot)
COPILOT_FACTOR_API_URL=https://your-endpoint/api/generate-factors
COPILOT_FACTOR_API_KEY=your-api-key-here
